{
  "name": "opencode-mouth",
  "version": "1.1.0",
  "description": "Potty mouth detector for OpenCode: measure what comes out of your model's mouth (and yours)",
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist/tui.js",
    "dist/tui.js.map"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "shellcheck": "shellcheck scripts/*.sh",
    "check": "npm run typecheck && npm run build && npm test",
    "release": "bash scripts/release.sh",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@opencode-ai/plugin": "^1.18.26",
    "@opentui/core": "^0.5.11",
    "@opentui/keymap": "^0.5.10",
    "@opentui/solid": "^0.5.11",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "babel-preset-solid": "^1.9.15",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixincreate/opencode-mouth.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "profanity",
    "behavior",
    "dashboard"
  ],
  "license": "MIT",
  "overrides": {
    "@opentui/solid": {
      "@babel/core": "^7.29.6"
    }
  }
}
